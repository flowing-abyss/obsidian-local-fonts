{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.ts", "*.mjs", "*.mts", "tests/e2e/**/*.ts", "tests/e2e/**/*.mts"],
  "entry": ["tests/e2e/**/*.e2e.ts"],
  "ignoreDependencies": [
    // wdio services/frameworks/drivers referenced by plugin-name string in the wdio
    // configs (`services: ['obsidian', ['appium', ...]]`, `framework: 'mocha'`), not
    // by import — knip can't trace those.
    "@wdio/appium-service",
    "@wdio/local-runner",
    "@wdio/mocha-framework",
    "wdio-obsidian-reporter",
  ],
  "include": ["files", "dependencies", "unlisted", "unresolved", "exports", "types", "duplicates"],
  "ignore": ["src/fonts/types.ts"],
  // RoleName/RoleAssignments in settings.ts are exported for later tasks (settings UI) but
  // only consumed within settings.ts itself today. Scoped to "type" only so unused
  // interfaces/functions/classes elsewhere still get flagged as real dead code.
  "ignoreExportsUsedInFile": { "type": true },
}
