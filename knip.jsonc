{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.ts", "*.mjs", "*.mts", "tests/e2e/**/*.ts", "tests/e2e/**/*.mts"],
  "entry": ["tests/e2e/**/*.e2e.ts"],
  "ignoreDependencies": [
    // wdio services/frameworks/drivers referenced by plugin-name string in the wdio
    // configs (`services: ['obsidian', ['appium', ...]]`, `framework: 'mocha'`), not
    // by import — knip can't trace those.
    "@wdio/appium-service",
    "@wdio/local-runner",
    "@wdio/mocha-framework",
    "wdio-obsidian-reporter",
  ],
  "include": ["files", "dependencies", "unlisted", "unresolved", "exports", "types", "duplicates"],
  "ignore": [
    // ColorFormat/Script/VariableAxis are consumed by sfnt.ts as of Task 4. The
    // remaining exports (FaceRecord, FontFormat, MetadataSource, CACHE_VERSION) are
    // consumed by the cache layer in a later task; this entry comes out once every
    // export here is used.
    "src/fonts/types.ts",
    // RoleName/RoleAssignments are consumed by the settings UI in a later task; this
    // entry comes out once that lands (mirrors the src/fonts/types.ts entry above).
    "src/settings.ts",
    // Test-only support code (fixture path helper used by unit tests, not by the
    // plugin itself). This entry is permanent, unlike the two above.
    "src/fonts/fixtures.ts",
    // FileReader is the shape the vault-scanning layer will implement in a later
    // task; extractMetadata takes it as a parameter type, not a re-exported symbol,
    // so knip can't see the future caller. This entry comes out once that lands.
    "src/fonts/metadata.ts",
  ],
}
